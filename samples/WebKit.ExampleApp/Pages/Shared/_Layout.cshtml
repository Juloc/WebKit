@using WebKit.Web.Notifications
@inject IUserContext UserContext
@inject IFlashMessageStore FlashMessages
@{
    IReadOnlyList<FlashMessage> messages = FlashMessages.Read();
    var toasts = messages.Select(message => new ToastMessageModel(
        message.Text,
        message.Kind switch
        {
            FlashMessageKind.Success => ToastKind.Success,
            FlashMessageKind.Warning => ToastKind.Warning,
            FlashMessageKind.Error => ToastKind.Error,
            _ => ToastKind.Information
        },
        message.Kind == FlashMessageKind.Error)).ToArray();
    List<NavigationItemModel> navigationItems =
    [
        new("Home", "/", Context.Request.Path == "/"),
        new("Catalog", "/Products", Context.Request.Path.StartsWithSegments("/Products"))
    ];
    if (UserContext.IsAuthenticated)
    {
        navigationItems.Add(new("Settings", "/Settings", Context.Request.Path.StartsWithSegments("/Settings")));
    }
    if (UserContext.HasCapability("admin"))
    {
        navigationItems.Add(new("Admin", "/Admin", Context.Request.Path.StartsWithSegments("/Admin")));
    }
    NavigationModel navigation = new([new NavigationGroupModel(null, navigationItems)]);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - WebKit Example</title>
    <link rel="stylesheet" href="/_content/Juloc.WebKit.Design/css/webkit-design.css" />
    <link rel="stylesheet" href="/_content/Juloc.WebKit.UI/css/webkit-ui.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wk-shell">
        <aside class="wk-sidebar">
            <a class="wk-brand" href="/"><span class="wk-brand-mark" aria-hidden="true">W</span> WebKit</a>
            <partial name="_Navigation" model="navigation" />
        </aside>
        <div class="wk-main">
            <header class="wk-header">
                <span class="wk-muted">A small server-rendered reference app</span>
                <div class="wk-user-menu">
                    <partial name="_ThemeControl" />
                    <div class="wk-theme-presets" aria-label="Theme presets">
                        <button class="wk-button" type="button" data-theme-preset="media">Media</button>
                        <button class="wk-button" type="button" data-theme-preset="finance">Finance</button>
                        <button class="wk-button" type="button" data-theme-preset="document">Document</button>
                    </div>
                    @if (UserContext.IsAuthenticated)
                    {
                        <span>@UserContext.DisplayName</span>
                        <form method="post" action="/Account/Logout"><button class="wk-button" type="submit">Sign out</button></form>
                    }
                    else
                    {
                        <a class="wk-button" href="/Account/Login">Sign in</a>
                    }
                </div>
            </header>
            <main class="wk-content">@RenderBody()</main>
        </div>
    </div>
    <partial name="_Toasts" model="new ToastModel(toasts)" />
    <script src="/_content/Juloc.WebKit.UI/js/webkit-ui.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
