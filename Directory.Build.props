<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WebKitVersion>0.2.0</WebKitVersion>
    <Version>$(WebKitVersion)</Version>
    <Authors>Juloc</Authors>
    <RepositoryUrl>https://github.com/Juloc/WebKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aspnetcore;razor;application-kit;design-system;accessibility</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>CS1591;CA1000</NoWarn>
  </PropertyGroup>
</Project>
