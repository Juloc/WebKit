@model ForbiddenStateModel

@{
    string titleId = $"forbidden-{Guid.NewGuid():N}";
}
<section class="wk-card wk-empty" role="alert" aria-labelledby="@titleId">
    <h2 id="@titleId">@Model.Title</h2>
    <p class="wk-muted">@Model.Description</p>
    <a class="wk-button" href="/">Back to home</a>
</section>
