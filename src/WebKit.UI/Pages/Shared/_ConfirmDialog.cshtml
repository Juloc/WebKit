@model ConfirmDialogModel

<dialog id="@Model.DialogId" class="wk-dialog" aria-labelledby="@Model.TitleId">
    <div class="wk-dialog-body">
        <h2 id="@Model.TitleId">@Model.Title</h2>
        <p>@Model.Description</p>
        <form class="wk-actions" method="post" action="@Model.ActionUrl">
            @Html.AntiForgeryToken()
            <button class="wk-button" type="button" data-dialog-close="@Model.DialogId">@Model.CancelText</button>
            <button class="wk-button wk-button-danger" type="submit">@Model.ConfirmText</button>
        </form>
    </div>
</dialog>
